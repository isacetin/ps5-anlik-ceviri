{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anlık Çeviri",
  "version": "0.1.0",
  "identifier": "com.isacetin.anlikceviri",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Anlık Çeviri",
        "width": 440,
        "height": 740,
        "minWidth": 380,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "15.0",
      "signingIdentity": "-"
    },
    "category": "Utility",
    "shortDescription": "Oyunlardaki İngilizce yazıları anlık Türkçeye çevirir",
    "copyright": "© 2026 isacetin",
    "windows": {
      "nsis": {
        "languages": [
          "Turkish",
          "English"
        ],
        "displayLanguageSelector": false
      }
    }
  }
}
